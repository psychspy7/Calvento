{
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-and-conditions/index.html"
    },
    {
      "source": "/terms-and-conditions/",
      "destination": "/terms-and-conditions/index.html"
    },
    {
      "source": "/shipping-returns",
      "destination": "/shipping-returns/index.html"
    },
    {
      "source": "/shipping-returns/",
      "destination": "/shipping-returns/index.html"
    },
    {
      "source": "/refund-cancellation",
      "destination": "/refund-cancellation/index.html"
    },
    {
      "source": "/refund-cancellation/",
      "destination": "/refund-cancellation/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact/index.html"
    },
    {
      "source": "/products/:slug",
      "destination": "/products/:slug/index.html"
    },
    {
      "source": "/products/:slug/",
      "destination": "/products/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}